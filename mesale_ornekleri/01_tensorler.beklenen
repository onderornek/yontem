a =
tensör([[1.0000, 2.0000, 3.0000],
        [4.0000, 5.0000, 6.0000]])
şekil: [2, 3], öğe sayısı: 6

a + b =
tensör([[11.0000, 22.0000, 33.0000],
        [14.0000, 25.0000, 36.0000]])
a @ a.T =
tensör([[14.0000, 32.0000],
        [32.0000, 77.0000]])
satır ortalamaları: tensör([2.0000, 5.0000])
en büyük ve yeri  : [tensör([3.0000, 6.0000]), tensör([2.0000, 2.0000])]

view(3, 2):
tensör([[1.0000, 2.0000],
        [3.0000, 4.0000],
        [5.0000, 6.0000]])
unsqueeze(0) şekli: [1, 2, 3], permute(1, 0) şekli: [3, 2]

y = 40.25
w.grad = tensör([ 1.0000, -8.0000, 36.0000])
elle hesap: tensör([ 1.0000, -8.0000, 36.0000])

randn(2, 2, 3):
tensör([[[ 0.9417, -1.3966, -0.6797],
         [ 0.3705, -1.0163, -0.0721]],

