{
  "name": "yontem",
  "version": "0.5.0",
  "description": "Yöntem programlama dili — JavaScript'e derleyen derleyici ve çalışma zamanı",
  "license": "MIT",
  "author": "Önder Örnek",
  "bin": {
    "yontem": "dist/cli.js"
  },
  "main": "dist/calistir.js",
  "scripts": {
    "build": "node betikler/paketle.js && tsc -p . && node betikler/oyun_alani.js",
    "test": "node betikler/test.js",
    "test:gomulu": "node betikler/gomulu_test.js",
    "prepack": "node -e \"const f=require('fs');f.cpSync('../kutuphane','kutuphane',{recursive:true});f.copyFileSync('../LICENSE','LICENSE')\"",
    "postpack": "node -e \"const f=require('fs');f.rmSync('kutuphane',{recursive:true,force:true});f.rmSync('LICENSE',{force:true})\"",
    "test:ag": "node betikler/ag_testi.js",
    "test:dil": "node betikler/dil_sunucusu_testi.js",
    "test:ayikla": "node betikler/ayiklayici_testi.js",
    "test:paket": "node betikler/paket_testi.js",
    "test:kati": "node betikler/kati_testi.js",
    "test:sunucu": "node betikler/sunucu_testi.js",
    "test:vt": "node betikler/vt_testi.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "gomulu",
    "kutuphane"
  ],
  "homepage": "https://yontem.pro",
  "keywords": [
    "yöntem",
    "yontem",
    "programlama dili",
    "türkçe",
    "pascal",
    "derleyici",
    "eğitim"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onderornek/yontem.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/onderornek/yontem/issues"
  }
}
